{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Tomo",
  "version": "0.1.0",
  "identifier": "net.tomo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tomo",
        "width": 1000,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tomo"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Download manga/manhwa as CBZ for Tachimanga",
    "longDescription": "Tomo downloads every chapter of a manga/manhwa series as CBZ files for offline reading in Tachimanga.",
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    }
  }
}
